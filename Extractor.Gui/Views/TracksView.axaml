<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Extractor.Gui.ViewModels"
             xmlns:models="using:Extractor.Gui.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Extractor.Gui.Views.TracksView"
             x:DataType="vm:TracksViewModel"
             Loaded="OnLoaded">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Reload"
                    Command="{Binding ReloadCommand}"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top"
              RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" 
                       Text="Set your preferred track names and aliases to match to"/>
            <ScrollViewer Grid.Row="1"
                          Margin="0,8">
                <ItemsControl ItemsSource="{Binding TracksDto.Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TrackDenominationDto}">
                            <Grid ColumnDefinitions="*,8,2*"
                                  RowDefinitions="Auto,Auto"
                                  Margin="0,2">
                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="Your name:"/>
                                <TextBox Grid.Column="0" Grid.Row="1"
                                         Text="{Binding Cardinal}"/>
                                <TextBlock Grid.Column="2" Grid.Row="0"
                                           Text="Aliases (comma separated):"/>
                                <TextBox Grid.Column="2" Grid.Row="1"
                                         Text="{Binding AliasesJoined}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
